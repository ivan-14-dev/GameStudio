{
  "buildCommand": null,
  "outputDirectory": "client",
  "framework": null,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/javascript" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!js/|css/|assets/).*)", "destination": "/index.html" }
  ]
}
